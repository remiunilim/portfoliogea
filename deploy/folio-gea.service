# Modèle de service systemd pour Folio GEA (Next.js lancé en arrière-plan, derrière Apache).
# À adapter puis copier dans /etc/systemd/system/folio-gea.service.
#
# Installation (cloner directement sur le serveur, pour pouvoir mettre à jour avec
# deploy/mettre-a-jour.sh ensuite) :
#   sudo useradd --system --home /srv/folio-gea --shell /usr/sbin/nologin folio-gea
#   sudo git clone -b ovh https://github.com/remiunilim/portfoliogea.git /srv/folio-gea
#   # (branche ovh pour cette variante ; main pour la branche DSI)
#   sudo chown -R folio-gea:folio-gea /srv/folio-gea
#   cd /srv/folio-gea && sudo -u folio-gea cp .env.example .env.local
#   # puis renseigner .env.local (DB_*, APP_BASE_URL, SMTP_*, EMAIL_ETUDIANTS_DOMAINES)
#   sudo -u folio-gea npm ci && sudo -u folio-gea npm run build
#   # Le dossier data/ doit exister AVANT le premier démarrage : ReadWritePaths ci-dessous
#   # échoue sinon (erreur systemd 226/NAMESPACE), même si l'application le crée normalement
#   # elle-même au premier lancement.
#   sudo mkdir -p /srv/folio-gea/data/fichiers && sudo chown -R folio-gea:folio-gea /srv/folio-gea/data
#   sudo cp deploy/folio-gea.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now folio-gea
#
# Mise à jour vers une nouvelle version (après un nouveau développement) :
#   sudo deploy/mettre-a-jour.sh

[Unit]
Description=Folio GEA (Next.js)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=folio-gea
Group=folio-gea
WorkingDirectory=/srv/folio-gea
EnvironmentFile=/srv/folio-gea/.env.local
Environment=NODE_ENV=production
# -H 127.0.0.1 : n'écoute que les connexions venant du serveur lui-même (Apache). Sans lui, le
# port 3000 serait ouvert à tous, sans HTTPS, en contournant Apache.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
# Dossier des PDF déposés et de la base de données locale (si conservé) :
ReadWritePaths=/srv/folio-gea/data

[Install]
WantedBy=multi-user.target
