# Copier ce fichier en .env.local (ignoré par Git) et renseigner les valeurs réelles.

# Connexion à la base MariaDB (créée automatiquement au premier démarrage si elle n'existe pas).
DB_HOST=localhost
DB_PORT=3306
DB_USER=folio_gea
DB_PASSWORD=
DB_NAME=folio_gea

# Premier administrateur d'une installation neuve : créé automatiquement au démarrage s'il n'existe
# encore aucun administrateur (sinon personne ne pourrait se connecter, les comptes n'étant créés
# que par l'administrateur). Sans effet ensuite. ADMIN_NOM / ADMIN_PRENOM facultatifs.
ADMIN_EMAIL=
ADMIN_NOM=
ADMIN_PRENOM=

# Mode démonstration (comptes fictifs, connexion en choisissant un compte sans mot de passe) :
# actif d'office en local (npm run dev), JAMAIS en production sauf MODE_DEMO=1. À ne mettre à 1
# sur un serveur que le temps d'un test, avec des comptes fictifs.
MODE_DEMO=

# Adresse publique de l'application (sans / final), ex. https://folio-gea.universite.fr : sert à
# construire les liens des courriels de notification et les redirections après connexion SSO, et
# active les cookies réservés au HTTPS. À NE PAS laisser sur localhost sur le serveur : les liens des
# mails ouvriraient alors l'ordinateur de la personne qui clique, pas le serveur.
APP_BASE_URL=http://localhost:3000

# Connexion SSO OpenID Connect (identifiants de l'université), à demander à la DSI :
# l'adresse du fournisseur (issuer), un identifiant et une clé secrète d'application,
# et l'URL de retour à déclarer chez eux (OIDC_REDIRECT_URI, doit correspondre exactement).
# Tant que ces variables sont vides, l'application reste en mode démonstration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/connexion/oidc/callback
OIDC_SCOPE=openid email profile

# Envoi réel des courriels (SMTP de l'université). Tant que SMTP_HOST et SMTP_FROM sont vides,
# rien n'est expédié (les courriels restent en file d'attente). Même une fois ces variables
# renseignées, l'envoi reste coupé tant que l'administrateur ne l'a pas activé dans l'outil
# (page Étudiants et affectations) : personne ne reçoit de courriel par défaut.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Secret partagé pour la route qui vide la file de courriels (voir deploy/folio-gea-courriels*.service).
# Chaîne aléatoire à générer soi-même, jamais la valeur ci-dessous.
CRON_SECRET=
