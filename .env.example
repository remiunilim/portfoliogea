# Copier ce fichier en .env.local (ignoré par Git) et renseigner les valeurs réelles.

# Connexion à la base MariaDB (créée automatiquement au premier démarrage si elle n'existe pas).
DB_HOST=localhost
DB_PORT=3306
DB_USER=folio_gea
DB_PASSWORD=
DB_NAME=folio_gea

# Premier administrateur d'une installation neuve : créé automatiquement au démarrage s'il n'existe
# encore aucun administrateur (sinon personne ne pourrait se connecter, les comptes n'étant créés
# que par l'administrateur). Sans effet ensuite. ADMIN_NOM / ADMIN_PRENOM facultatifs.
ADMIN_EMAIL=
ADMIN_NOM=
ADMIN_PRENOM=

# Mode démonstration (comptes fictifs, connexion en choisissant un compte sans mot de passe) :
# actif d'office en local (npm run dev), JAMAIS en production sauf MODE_DEMO=1. À ne mettre à 1
# sur un serveur que le temps d'un test, avec des comptes fictifs.
MODE_DEMO=

# Adresse publique de l'application (sans / final), utilisée pour construire le lien de connexion
# envoyé par mail. Doit correspondre à l'adresse réelle une fois déployé (ex. https://folio-gea.exemple.fr).
# À NE PAS laisser sur localhost sur le serveur : le lien du mail ouvrirait alors l'ordinateur de la
# personne qui clique, pas le serveur. Après modification : sudo systemctl restart folio-gea
APP_BASE_URL=http://localhost:3000

# Domaines autorisés à créer leur propre profil étudiant (voir /connexion/creer-profil), séparés
# par des virgules si plusieurs. Vide = aucune restriction : à utiliser seulement en local/démo,
# sinon n'importe quelle adresse peut créer un profil étudiant. Sans effet sur la connexion d'un
# compte déjà créé par l'administrateur (import ou ajout manuel). Domaine exact : un sous-domaine
# (etu.unilim.fr) doit être cité à part.
EMAIL_ETUDIANTS_DOMAINES=unilim.fr,etu.unilim.fr

# Envoi des courriels (SMTP) : INDISPENSABLE dans cette version, car la connexion elle-même se fait
# par un lien envoyé par mail (pas de mot de passe, pas de SSO universitaire). Préférer un service
# d'envoi transactionnel (plutôt que le SMTP d'une messagerie classique), plus fiable et moins
# susceptible d'être bloqué comme spam par les fournisseurs de mail des étudiants et enseignants.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Secret partagé pour la route qui vide la file des courriels de NOTIFICATION (évaluation publiée…).
# Sans effet sur la connexion, qui est envoyée immédiatement (voir deploy/folio-gea-courriels*.service).
# Chaîne aléatoire à générer soi-même, jamais la valeur ci-dessous.
CRON_SECRET=
